# ============================================
# TempMail Configuration
# ============================================

# Server Port
PORT=3000

# ============================================
# Proxy Mode Configuration
# ============================================

# Railway.app: KHÔNG CẦN ScraperAPI! ✅
# Chỉ cần set (hoặc không set):
USE_PROXY=false

# Render.com: CẦN ScraperAPI ⚠️
# Uncomment và điền API key:
# USE_PROXY=true
# SCRAPERAPI_KEY=your_api_key_here

# ============================================
# Hướng dẫn lấy ScraperAPI Key (Free):
# ============================================
# CHỈ CẦN KHI DEPLOY LÊN RENDER.COM!
# 1. Đăng ký tại: https://www.scraperapi.com/
# 2. Free tier: 5,000 requests/tháng
# 3. Copy API key từ dashboard và paste vào SCRAPERAPI_KEY
#
# Lưu ý:
# - Local development: Không cần ScraperAPI (USE_PROXY=false)
# - Railway.app: KHÔNG CẦN ScraperAPI (USE_PROXY=false) ✅
# - Render.com: CẦN ScraperAPI (USE_PROXY=true + SCRAPERAPI_KEY) ⚠️
# - Mỗi email tạo: ~3-4 requests
# - Mỗi lần fetch messages: ~1 request
# - Ước tính: ~100-150 emails/tháng với free tier

