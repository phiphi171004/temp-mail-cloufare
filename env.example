# Server Port
PORT=3000

USE_PROXY=false

# SCRAPERAPI_KEY=your_api_key_here

# ============================================
# Encryption Secret (Dynamic Endpoint Obfuscation)
# ============================================
# Secret key để mã hóa API requests/responses
# Nên dùng một chuỗi ngẫu nhiên dài và phức tạp (ít nhất 32 ký tự)
# Có thể generate bằng: openssl rand -base64 32
# HOẶC: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET=your_encryption_secret_key_here

# Bật/tắt mã hóa (để debug: set false để tắt mã hóa)
# Default: true (bật mã hóa)
# Set false để tắt mã hóa và debug dễ dàng hơn
ENCRYPTION_ENABLED=true
PMAIL_IMAP_USER=your_email@gmail.com
PMAIL_IMAP_PASSWORD=your_app_password_here
PMAIL_IMAP_HOST=imap.gmail.com
PMAIL_IMAP_PORT=993
